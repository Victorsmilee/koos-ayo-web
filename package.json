{
  "name": "@koos/marketing",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "e2e": "playwright test",
    "e2e:ui": "playwright test e2e/ui.spec.ts",
    "verify": "npm run typecheck && npm test && python3 scripts/contrast.py && python3 scripts/check-brand-docs.py && npm run build",
    "instrument:json": "tsx scripts/export-instrument.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.118.0",
    "next": "16.4.2",
    "react": "19.1.10",
    "react-dom": "19.1.10",
    "server-only": "0.0.1",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "22.10.5",
    "@types/react": "19.0.7",
    "@types/react-dom": "19.0.3",
    "autoprefixer": "10.4.20",
    "postcss": "8.5.31",
    "tailwindcss": "3.4.19",
    "tsx": "4.19.2",
    "typescript": "5.7.3"
  }
}
