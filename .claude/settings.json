{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm run build)", "Bash(npm run dev)", "Bash(npm run lint)",
      "Bash(npm run test)", "Bash(npm run typecheck)", "Bash(npm install)",
      "Bash(npm ci)", "Bash(npm test)", "Bash(python3 scripts/contrast.py)",
      "Bash(git status)", "Bash(git diff:*)", "Bash(git log:*)",
      "Bash(git add:*)", "Bash(git checkout:*)", "Bash(git branch:*)",
      "Bash(git fetch:*)", "Bash(git pull:*)", "Bash(git push:*)",
      "Bash(gh pr create:*)", "Bash(gh pr view:*)", "Bash(gh pr list:*)",
      "Bash(gh pr diff:*)"
    ],
    "deny": [
      "Bash(git merge:*)",
      "Bash(gh pr merge:*)",
      "Bash(gh repo delete:*)",
      "Read(./.env.local)", "Read(./.env)", "Read(./**/.env*.local)"
    ]
  }
}
